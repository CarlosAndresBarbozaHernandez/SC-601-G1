@model IEnumerable<PAP.DataAccess.Customer>

@{
    ViewBag.Title = "Customers";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2>Customers</h2>

    @Html.ActionLink(
        "Add Customer",
        "Index",
        "Customers",
        new { create = true },
        new { @class = "btn btn-primary" }
    )
</div>


@if (ViewBag.CustomerDetail != null)
{
    var detail = (PAP.DataAccess.Customer)ViewBag.CustomerDetail;

    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Customer Details</strong>
        </div>

        <div class="panel-body">
            <p><strong>ID:</strong> @detail.Id</p>
            <p><strong>First Name:</strong> @detail.FirstName</p>
            <p><strong>Last Name:</strong> @detail.LastName</p>
            <p><strong>Email:</strong> @detail.Email</p>
            <p><strong>Phone:</strong> @detail.Phone</p>
            <p><strong>Birth Date:</strong> @detail.BirthDate</p>
            <p><strong>Active:</strong> @detail.IsActive</p>
            <p><strong>Created At:</strong> @detail.CreatedAt</p>
            <p><strong>Updated At:</strong> @detail.UpdatedAt</p>

            @Html.ActionLink(
                "Close",
                "Index",
                "Customers",
                null,
                new { @class = "btn btn-default" }
            )
        </div>
    </div>

    <hr />
}


@if (ViewBag.ShowCreate == true)
{
    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Add Customer</strong>
        </div>

        <div class="panel-body">

            @using (Html.BeginForm("Create", "Customers", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>First Name</label>
                    <input type="text"
                           name="FirstName"
                           class="form-control"
                           required />
                </div>

                <div class="form-group">
                    <label>Last Name</label>
                    <input type="text"
                           name="LastName"
                           class="form-control"
                           required />
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input type="email"
                           name="Email"
                           class="form-control"
                           required />
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input type="text"
                           name="PasswordHash"
                           class="form-control"
                           required />
                </div>

                <div class="form-group">
                    <label>Phone</label>
                    <input type="text"
                           name="Phone"
                           class="form-control" />
                </div>

                <div class="form-group">
                    <label>Birth Date</label>
                    <input type="date"
                           name="BirthDate"
                           class="form-control" />
                </div>

                <div class="checkbox">
                    <label>
                        <input type="checkbox"
                               name="IsActive"
                               value="true"
                               checked />
                        Active
                    </label>

                    <input type="hidden"
                           name="IsActive"
                           value="false" />
                </div>

                <br />

                <button type="submit"
                        class="btn btn-primary">
                    Add
                </button>

                @Html.ActionLink(
                    "Cancel",
                    "Index",
                    "Customers",
                    null,
                    new { @class = "btn btn-default" }
                )
            }

        </div>
    </div>

    <hr />
}


@if (ViewBag.CustomerEdit != null)
{
    var edit = (PAP.DataAccess.Customer)ViewBag.CustomerEdit;

    <h4>Edit Customer</h4>

    using (Html.BeginForm("Edit", "Customers", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <input type="hidden"
               name="Id"
               value="@edit.Id" />

        <input type="hidden"
               name="CreatedAt"
               value="@edit.CreatedAt" />

        <input type="hidden"
               name="PasswordHash"
               value="@edit.PasswordHash" />

        <div class="form-group">
            <label>First Name</label>
            <input type="text"
                   name="FirstName"
                   value="@edit.FirstName"
                   class="form-control"
                   required />
        </div>

        <div class="form-group">
            <label>Last Name</label>
            <input type="text"
                   name="LastName"
                   value="@edit.LastName"
                   class="form-control"
                   required />
        </div>

        <div class="form-group">
            <label>Email</label>
            <input type="email"
                   name="Email"
                   value="@edit.Email"
                   class="form-control"
                   required />
        </div>

        <div class="form-group">
            <label>Phone</label>
            <input type="text"
                   name="Phone"
                   value="@edit.Phone"
                   class="form-control" />
        </div>

        <div class="form-group">
            <label>Birth Date</label>
            <input type="date"
                   name="BirthDate"
                   value="@(edit.BirthDate.HasValue ? edit.BirthDate.Value.ToString("yyyy-MM-dd") : "")"
                   class="form-control" />
        </div>

        <div class="checkbox">
            <label>
                <input type="checkbox"
                       name="IsActive"
                       value="true"
                       @(edit.IsActive ? "checked" : "") />
                Active
            </label>

            <input type="hidden"
                   name="IsActive"
                   value="false" />
        </div>

        <br />

        <button type="submit"
                class="btn btn-primary">
            Save Changes
        </button>

        @Html.ActionLink(
            "Cancel",
            "Index",
            "Customers",
            null,
            new { @class = "btn btn-default" }
        )
    }

    <hr />
}


@if (ViewBag.CustomerDelete != null)
{
    var delete = (PAP.DataAccess.Customer)ViewBag.CustomerDelete;

    <div class="panel panel-warning">
        <div class="panel-heading">
            <strong>Confirm Delete</strong>
        </div>

        <div class="panel-body">

            <p>Are you sure you want to delete this customer?</p>

            <p><strong>ID:</strong> @delete.Id</p>

            <p>
                <strong>Customer:</strong>
                @delete.FirstName @delete.LastName
            </p>

            <p>
                <strong>Email:</strong>
                @delete.Email
            </p>

            @using (Html.BeginForm("Delete", "Customers", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@delete.Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Confirm Delete
                </button>
            }

            @Html.ActionLink(
                "Cancel",
                "Index",
                "Customers",
                null,
                new { @class = "btn btn-default" }
            )

        </div>
    </div>

    <hr />
}


<h4>Customer List</h4>

<table class="table">
    <tr>
        <th>ID</th>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Birth Date</th>
        <th>Active</th>
        <th>Created At</th>
        <th>Updated At</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.FirstName</td>
            <td>@item.LastName</td>
            <td>@item.Email</td>
            <td>@item.Phone</td>
            <td>@item.BirthDate</td>
            <td>@item.IsActive</td>
            <td>@item.CreatedAt</td>
            <td>@item.UpdatedAt</td>

            <td>
                @Html.ActionLink(
                    "Edit",
                    "Index",
                    "Customers",
                    new { editId = item.Id },
                    null
                )
                |
                @Html.ActionLink(
                    "Details",
                    "Index",
                    "Customers",
                    new { detailsId = item.Id },
                    null
                )
                |
                @Html.ActionLink(
                    "Delete",
                    "Index",
                    "Customers",
                    new { deleteId = item.Id },
                    null
                )
            </td>
        </tr>
    }
</table>