@model IEnumerable<PAP.DataAccess.ShoppingCart>

@{
    ViewBag.Title = "Shopping Carts";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2>Shopping Carts</h2>

    @Html.ActionLink(
        "Add Shopping Cart",
        "Index",
        "ShoppingCarts",
        new { create = true },
        new { @class = "btn btn-primary" }
    )
</div>


@if (ViewBag.ShoppingCartDetail != null)
{
    var detail = (PAP.DataAccess.ShoppingCart)ViewBag.ShoppingCartDetail;

    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Shopping Cart Details</strong>
        </div>

        <div class="panel-body">
            <p><strong>ID:</strong> @detail.Id</p>
            <p><strong>Customer ID:</strong> @detail.CustomerId</p>
            <p><strong>Created At:</strong> @detail.CreatedAt</p>
            <p><strong>Updated At:</strong> @detail.UpdatedAt</p>

            @Html.ActionLink(
                "Close",
                "Index",
                "ShoppingCarts",
                null,
                new { @class = "btn btn-default" }
            )
        </div>
    </div>

    <hr />
}


@if (ViewBag.ShowCreate == true)
{
    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Add Shopping Cart</strong>
        </div>

        <div class="panel-body">

            @using (Html.BeginForm("Create", "ShoppingCarts", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Customer ID</label>

                    <input type="number"
                           name="CustomerId"
                           class="form-control"
                           required />
                </div>

                <br />

                <button type="submit"
                        class="btn btn-primary">
                    Add
                </button>

                @Html.ActionLink(
                    "Cancel",
                    "Index",
                    "ShoppingCarts",
                    null,
                    new { @class = "btn btn-default" }
                )
            }

        </div>
    </div>

    <hr />
}


@if (ViewBag.ShoppingCartEdit != null)
{
    var edit = (PAP.DataAccess.ShoppingCart)ViewBag.ShoppingCartEdit;

    <h4>Edit Shopping Cart</h4>

    using (Html.BeginForm("Edit", "ShoppingCarts", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <input type="hidden"
               name="Id"
               value="@edit.Id" />

        <input type="hidden"
               name="CreatedAt"
               value="@edit.CreatedAt" />

        <div class="form-group">
            <label>Customer ID</label>

            <input type="number"
                   name="CustomerId"
                   value="@edit.CustomerId"
                   class="form-control"
                   required />
        </div>

        <br />

        <button type="submit"
                class="btn btn-primary">
            Save Changes
        </button>

        @Html.ActionLink(
            "Cancel",
            "Index",
            "ShoppingCarts",
            null,
            new { @class = "btn btn-default" }
        )
    }

    <hr />
}


@if (ViewBag.ShoppingCartDelete != null)
{
    var delete = (PAP.DataAccess.ShoppingCart)ViewBag.ShoppingCartDelete;

    <div class="panel panel-warning">
        <div class="panel-heading">
            <strong>Confirm Delete</strong>
        </div>

        <div class="panel-body">

            <p>Are you sure you want to delete this shopping cart?</p>

            <p><strong>Cart ID:</strong> @delete.Id</p>
            <p><strong>Customer ID:</strong> @delete.CustomerId</p>

            @using (Html.BeginForm("Delete", "ShoppingCarts", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@delete.Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Confirm Delete
                </button>
            }

            @Html.ActionLink(
                "Cancel",
                "Index",
                "ShoppingCarts",
                null,
                new { @class = "btn btn-default" }
            )

        </div>
    </div>

    <hr />
}


<h4>Shopping Cart List</h4>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Customer ID</th>
        <th>Created At</th>
        <th>Updated At</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.CustomerId</td>
            <td>@item.CreatedAt</td>
            <td>@item.UpdatedAt</td>

            <td>
                @Html.ActionLink(
                    "Edit",
                    "Index",
                    "ShoppingCarts",
                    new { editId = item.Id },
                    null
                )
                |
                @Html.ActionLink(
                    "Details",
                    "Index",
                    "ShoppingCarts",
                    new { detailsId = item.Id },
                    null
                )
                |
                @Html.ActionLink(
                    "Delete",
                    "Index",
                    "ShoppingCarts",
                    new { deleteId = item.Id },
                    null
                )
            </td>
        </tr>
    }
</table>