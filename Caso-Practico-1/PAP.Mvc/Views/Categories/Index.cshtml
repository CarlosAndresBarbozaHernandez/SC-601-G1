@model IEnumerable<PAP.DataAccess.Category>

@{
    ViewBag.Title = "Categories";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2>Categories</h2>

    @Html.ActionLink(
        "Add Category",
        "Index",
        "Categories",
        new { create = true },
        new { @class = "btn btn-primary" }
    )
</div>


@if (ViewBag.CategoryDetail != null)
{
    var detail = (PAP.DataAccess.Category)ViewBag.CategoryDetail;

    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Category Details</strong>
        </div>

        <div class="panel-body">
            <p><strong>Name:</strong> @detail.Name</p>
            <p><strong>Description:</strong> @detail.Description</p>

            @Html.ActionLink(
                "Close",
                "Index",
                "Categories",
                null,
                new { @class = "btn btn-default" }
            )
        </div>
    </div>

    <hr />
}


@if (ViewBag.ShowCreate == true)
{
    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Add Category</strong>
        </div>

        <div class="panel-body">

            @using (Html.BeginForm("Create", "Categories", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Name</label>

                    <input type="text"
                           name="Name"
                           class="form-control"
                           required />
                </div>

                <div class="form-group">
                    <label>Description</label>

                    <input type="text"
                           name="Description"
                           class="form-control" />
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Add
                </button>

                @Html.ActionLink(
                    "Cancel",
                    "Index",
                    "Categories",
                    null,
                    new { @class = "btn btn-default" }
                )
            }

        </div>
    </div>

    <hr />
}


@if (ViewBag.CategoryEdit != null)
{
    var edit = (PAP.DataAccess.Category)ViewBag.CategoryEdit;

    <h4>Edit Category</h4>

    using (Html.BeginForm("Edit", "Categories", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <input type="hidden"
               name="Id"
               value="@edit.Id" />

        <div class="form-group">
            <label>Name</label>

            <input type="text"
                   name="Name"
                   value="@edit.Name"
                   class="form-control"
                   required />
        </div>

        <div class="form-group">
            <label>Description</label>

            <input type="text"
                   name="Description"
                   value="@edit.Description"
                   class="form-control" />
        </div>

        <button type="submit"
                class="btn btn-primary">
            Save Changes
        </button>

        @Html.ActionLink(
            "Cancel",
            "Index",
            "Categories",
            null,
            new { @class = "btn btn-default" }
        )
    }

    <hr />
}


@if (ViewBag.CategoryDelete != null)
{
    var delete = (PAP.DataAccess.Category)ViewBag.CategoryDelete;

    <div class="panel panel-warning">
        <div class="panel-heading">
            <strong>Confirm Delete</strong>
        </div>

        <div class="panel-body">

            <p>Are you sure you want to delete this category?</p>

            <p>
                <strong>Name:</strong>
                @delete.Name
            </p>

            <p>
                <strong>Description:</strong>
                @delete.Description
            </p>

            @using (Html.BeginForm("Delete", "Categories", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@delete.Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Confirm Delete
                </button>
            }

            @Html.ActionLink(
                "Cancel",
                "Index",
                "Categories",
                null,
                new { @class = "btn btn-default" }
            )

        </div>
    </div>

    <hr />
}


<h4>Category List</h4>

<table class="table">
    <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Description</td>

            <td>
                @Html.ActionLink(
                    "Edit",
                    "Index",
                    "Categories",
                    new { editId = item.Id },
                    null
                )
                |
                @Html.ActionLink(
                    "Details",
                    "Index",
                    "Categories",
                    new { detailsId = item.Id },
                    null
                )
                |
                @Html.ActionLink(
                    "Delete",
                    "Index",
                    "Categories",
                    new { deleteId = item.Id },
                    null
                )
            </td>
        </tr>
    }

</table>