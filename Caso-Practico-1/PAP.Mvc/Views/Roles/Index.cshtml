@model IEnumerable<PAP.DataAccess.Role>

@{
    ViewBag.Title = "Roles";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2>Roles</h2>

    @Html.ActionLink(
        "Add Role",
        "Index",
        "Roles",
        new { create = true },
        new { @class = "btn btn-primary" }
    )
</div>


@if (ViewBag.RoleDetail != null)
{
    var detail = (PAP.DataAccess.Role)ViewBag.RoleDetail;

    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Role Details</strong>
        </div>

        <div class="panel-body">
            <p><strong>ID:</strong> @detail.Id</p>
            <p><strong>Name:</strong> @detail.Name</p>

            @Html.ActionLink(
                "Close",
                "Index",
                "Roles",
                null,
                new { @class = "btn btn-default" }
            )
        </div>
    </div>

    <hr />
}


@if (ViewBag.ShowCreate == true)
{
    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Add Role</strong>
        </div>

        <div class="panel-body">

            @using (Html.BeginForm("Create", "Roles", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Name</label>

                    <input type="text"
                           name="Name"
                           class="form-control"
                           required />
                </div>

                <br />

                <button type="submit"
                        class="btn btn-primary">
                    Add
                </button>

                @Html.ActionLink(
                    "Cancel",
                    "Index",
                    "Roles",
                    null,
                    new { @class = "btn btn-default" }
                )
            }

        </div>
    </div>

    <hr />
}


@if (ViewBag.RoleEdit != null)
{
    var edit = (PAP.DataAccess.Role)ViewBag.RoleEdit;

    <h4>Edit Role</h4>

    using (Html.BeginForm("Edit", "Roles", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <input type="hidden"
               name="Id"
               value="@edit.Id" />

        <div class="form-group">
            <label>Name</label>

            <input type="text"
                   name="Name"
                   value="@edit.Name"
                   class="form-control"
                   required />
        </div>

        <br />

        <button type="submit"
                class="btn btn-primary">
            Save Changes
        </button>

        @Html.ActionLink(
            "Cancel",
            "Index",
            "Roles",
            null,
            new { @class = "btn btn-default" }
        )
    }

    <hr />
}


@if (ViewBag.RoleDelete != null)
{
    var delete = (PAP.DataAccess.Role)ViewBag.RoleDelete;

    <div class="panel panel-warning">
        <div class="panel-heading">
            <strong>Confirm Delete</strong>
        </div>

        <div class="panel-body">

            <p>
                Are you sure you want to delete this role?
            </p>

            <p>
                <strong>ID:</strong>
                @delete.Id
            </p>

            <p>
                <strong>Name:</strong>
                @delete.Name
            </p>

            @using (Html.BeginForm("Delete", "Roles", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@delete.Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Confirm Delete
                </button>
            }

            <br />

            @Html.ActionLink(
                "Cancel",
                "Index",
                "Roles",
                null,
                new { @class = "btn btn-default" }
            )

        </div>
    </div>

    <hr />
}


<h4>Role List</h4>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>

            <td>
                @Html.ActionLink(
                    "Edit",
                    "Index",
                    "Roles",
                    new { editId = item.Id },
                    null
                )
                |
                @Html.ActionLink(
                    "Details",
                    "Index",
                    "Roles",
                    new { detailsId = item.Id },
                    null
                )
                |
                @Html.ActionLink(
                    "Delete",
                    "Index",
                    "Roles",
                    new { deleteId = item.Id },
                    null
                )
            </td>
        </tr>
    }
</table>