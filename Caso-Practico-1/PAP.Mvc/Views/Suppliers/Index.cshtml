@model IEnumerable<PAP.DataAccess.Supplier>

@{
    ViewBag.Title = "Suppliers";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2>Suppliers</h2>

    @Html.ActionLink(
        "Add Supplier",
        "Index",
        "Suppliers",
        new { create = true },
        new { @class = "btn btn-primary" }
    )
</div>


@if (ViewBag.SupplierDetail != null)
{
    var detail = (PAP.DataAccess.Supplier)ViewBag.SupplierDetail;

    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Supplier Details</strong>
        </div>

        <div class="panel-body">
            <p><strong>ID:</strong> @detail.Id</p>
            <p><strong>Name:</strong> @detail.Name</p>
            <p><strong>Contact Name:</strong> @detail.ContactName</p>
            <p><strong>Email:</strong> @detail.Email</p>
            <p><strong>Phone:</strong> @detail.Phone</p>
            <p><strong>Address:</strong> @detail.Address</p>
            <p><strong>Active:</strong> @detail.IsActive</p>

            @Html.ActionLink(
                "Close",
                "Index",
                "Suppliers",
                null,
                new { @class = "btn btn-default" }
            )
        </div>
    </div>

    <hr />
}


@if (ViewBag.ShowCreate == true)
{
    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Add Supplier</strong>
        </div>

        <div class="panel-body">

            @using (Html.BeginForm("Create", "Suppliers", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Name</label>
                    <input type="text"
                           name="Name"
                           class="form-control"
                           required />
                </div>

                <div class="form-group">
                    <label>Contact Name</label>
                    <input type="text"
                           name="ContactName"
                           class="form-control" />
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input type="email"
                           name="Email"
                           class="form-control" />
                </div>

                <div class="form-group">
                    <label>Phone</label>
                    <input type="text"
                           name="Phone"
                           class="form-control" />
                </div>

                <div class="form-group">
                    <label>Address</label>
                    <input type="text"
                           name="Address"
                           class="form-control" />
                </div>

                <div class="checkbox">
                    <label>
                        <input type="checkbox"
                               name="IsActive"
                               value="true" />
                        Active
                    </label>
                </div>

                <input type="hidden"
                       name="IsActive"
                       value="false" />

                <br />

                <button type="submit"
                        class="btn btn-primary">
                    Add
                </button>

                @Html.ActionLink(
                    "Cancel",
                    "Index",
                    "Suppliers",
                    null,
                    new { @class = "btn btn-default" }
                )
            }

        </div>
    </div>

    <hr />
}


@if (ViewBag.SupplierEdit != null)
{
    var edit = (PAP.DataAccess.Supplier)ViewBag.SupplierEdit;

    <h4>Edit Supplier</h4>

    using (Html.BeginForm("Edit", "Suppliers", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <input type="hidden"
               name="Id"
               value="@edit.Id" />

        <div class="form-group">
            <label>Name</label>

            <input type="text"
                   name="Name"
                   value="@edit.Name"
                   class="form-control"
                   required />
        </div>

        <div class="form-group">
            <label>Contact Name</label>

            <input type="text"
                   name="ContactName"
                   value="@edit.ContactName"
                   class="form-control" />
        </div>

        <div class="form-group">
            <label>Email</label>

            <input type="email"
                   name="Email"
                   value="@edit.Email"
                   class="form-control" />
        </div>

        <div class="form-group">
            <label>Phone</label>

            <input type="text"
                   name="Phone"
                   value="@edit.Phone"
                   class="form-control" />
        </div>

        <div class="form-group">
            <label>Address</label>

            <input type="text"
                   name="Address"
                   value="@edit.Address"
                   class="form-control" />
        </div>

        <div class="checkbox">
            <label>
                <input type="checkbox"
                       name="IsActive"
                       value="true"
                       @(edit.IsActive ? "checked" : "") />
                Active
            </label>
        </div>

        <input type="hidden"
               name="IsActive"
               value="false" />

        <br />

        <button type="submit"
                class="btn btn-primary">
            Save Changes
        </button>

        @Html.ActionLink(
            "Cancel",
            "Index",
            "Suppliers",
            null,
            new { @class = "btn btn-default" }
        )
    }

    <hr />
}


@if (ViewBag.SupplierDelete != null)
{
    var delete = (PAP.DataAccess.Supplier)ViewBag.SupplierDelete;

    <div class="panel panel-warning">
        <div class="panel-heading">
            <strong>Confirm Delete</strong>
        </div>

        <div class="panel-body">

            <p>Are you sure you want to delete this supplier?</p>

            <p><strong>ID:</strong> @delete.Id</p>
            <p><strong>Name:</strong> @delete.Name</p>
            <p><strong>Contact:</strong> @delete.ContactName</p>

            @using (Html.BeginForm("Delete", "Suppliers", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@delete.Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Confirm Delete
                </button>
            }

            <br />

            @Html.ActionLink(
                "Cancel",
                "Index",
                "Suppliers",
                null,
                new { @class = "btn btn-default" }
            )

        </div>
    </div>

    <hr />
}


<h4>Supplier List</h4>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Contact Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Address</th>
        <th>Active</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.ContactName</td>
            <td>@item.Email</td>
            <td>@item.Phone</td>
            <td>@item.Address</td>
            <td>@item.IsActive</td>

            <td>
                @Html.ActionLink(
                    "Edit",
                    "Index",
                    "Suppliers",
                    new { editId = item.Id },
                    null
                )
                |
                @Html.ActionLink(
                    "Details",
                    "Index",
                    "Suppliers",
                    new { detailsId = item.Id },
                    null
                )
                |
                @Html.ActionLink(
                    "Delete",
                    "Index",
                    "Suppliers",
                    new { deleteId = item.Id },
                    null
                )
            </td>
        </tr>
    }
</table>