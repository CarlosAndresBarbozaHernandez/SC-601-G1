@model List<PAP.Mvc.Controllers.AdminController.AdminTableStatus>

@{
    ViewBag.Title = "Admin - Generators";

    int total = Model.Count;
    int withData = Model.Count(t => t.HasData);
    int ready = Model.Count(t => !t.HasData && t.CanGenerate && t.Missing.Count == 0);
    int waiting = Model.Count(t => !t.HasData && t.Missing.Count > 0);
    int totalRows = Model.Sum(t => t.Rows);
    int percent = total == 0 ? 0 : (withData * 100 / total);
}

<div class="admin-head">
    <h2>Admin: generación de datos</h2>
    <p class="text-muted">Genera los datos iniciales siguiendo el orden de dependencias entre tablas.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">✓ @TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">✕ @TempData["Error"]</div>
}

<div class="stats">
    <div class="stat">
        <div class="stat-label">Tablas con datos</div>
        <div class="stat-value ok">@withData<span class="text-muted" style="font-size:1rem">/@total</span></div>
        <div class="progress-track"><div class="progress-fill" style="width:@(percent)%"></div></div>
    </div>
    <div class="stat">
        <div class="stat-label">Listas para generar</div>
        <div class="stat-value ready">@ready</div>
    </div>
    <div class="stat">
        <div class="stat-label">Esperando dependencias</div>
        <div class="stat-value wait">@waiting</div>
    </div>
    <div class="stat">
        <div class="stat-label">Registros totales</div>
        <div class="stat-value">@totalRows.ToString("N0")</div>
    </div>
</div>

<table class="table no-count">
    <thead>
        <tr>
            <th>Tabla</th>
            <th>Nivel</th>
            <th>Estado</th>
            <th style="text-align:right">Registros</th>
            <th style="text-align:right">Generar</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>
                    <div class="tbl-name"><span class="schema">dbo.</span>@t.Name</div>
                    @if (t.Missing.Count > 0)
                    {
                        <div class="tbl-missing">Falta: <b>@string.Join(", ", t.Missing)</b></div>
                    }
                </td>
                <td><span class="tbl-level">N@(t.Level)</span></td>
                <td>
                    @if (t.HasData)
                    {
                        <span class="chip chip-ok">Con datos</span>
                    }
                    else if (t.Missing.Count > 0)
                    {
                        <span class="chip chip-wait">Bloqueada</span>
                    }
                    else
                    {
                        <span class="chip chip-ready">Lista</span>
                    }
                </td>
                <td class="tbl-rows">@t.Rows.ToString("N0")</td>
                <td style="text-align:right">
                    @using (Html.BeginForm(t.Action, "Admin", FormMethod.Post, new { style = "display:inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@(!t.CanGenerate)">
                            Generar
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>