@{
    ViewBag.Title = "Admin - Generators";
}

<h2>Data Generators</h2>

<p>
    Generate initial data for the database entities.
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Entity</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        <tr>
            <td>Authors</td>
            <td>
                @using (Html.BeginForm("GenerateAuthors", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@(!ViewBag.CanGenerateAuthors)">
                        Generate
                    </button>
                }
            </td>
        </tr>

