@model IEnumerable<PAP.DataAccess.Review>

@{
    ViewBag.Title = "Reviews";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2>Reviews</h2>

    @Html.ActionLink(
        "Add Review",
        "Index",
        "Reviews",
        new { create = true },
        new { @class = "btn btn-primary" }
    )
</div>


@if (ViewBag.ReviewDetail != null)
{
    var detail = (PAP.DataAccess.Review)ViewBag.ReviewDetail;

    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Review Details</strong>
        </div>

        <div class="panel-body">
            <p><strong>ID:</strong> @detail.Id</p>
            <p><strong>Book ID:</strong> @detail.BookId</p>
            <p><strong>Customer ID:</strong> @detail.CustomerId</p>
            <p><strong>Rating:</strong> @detail.Rating</p>
            <p><strong>Comment:</strong> @detail.Comment</p>
            <p><strong>Created At:</strong> @detail.CreatedAt</p>

            @Html.ActionLink(
                "Close",
                "Index",
                "Reviews",
                null,
                new { @class = "btn btn-default" }
            )
        </div>
    </div>

    <hr />
}


@if (ViewBag.ShowCreate == true)
{
    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Add Review</strong>
        </div>

        <div class="panel-body">

            @using (Html.BeginForm("Create", "Reviews", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Book ID</label>

                    <input type="number"
                           name="BookId"
                           class="form-control"
                           required />
                </div>

                <div class="form-group">
                    <label>Customer ID</label>

                    <input type="number"
                           name="CustomerId"
                           class="form-control"
                           required />
                </div>

                <div class="form-group">
                    <label>Rating</label>

                    <input type="number"
                           name="Rating"
                           min="1"
                           max="5"
                           class="form-control"
                           required />
                </div>

                <div class="form-group">
                    <label>Comment</label>

                    <textarea name="Comment"
                              class="form-control"
                              rows="3"></textarea>
                </div>

                <br />

                <button type="submit"
                        class="btn btn-primary">
                    Add
                </button>

                @Html.ActionLink(
                    "Cancel",
                    "Index",
                    "Reviews",
                    null,
                    new { @class = "btn btn-default" }
                )
            }

        </div>
    </div>

    <hr />
}


@if (ViewBag.ReviewEdit != null)
{
    var edit = (PAP.DataAccess.Review)ViewBag.ReviewEdit;

    <h4>Edit Review</h4>

    using (Html.BeginForm("Edit", "Reviews", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <input type="hidden"
               name="Id"
               value="@edit.Id" />

        <input type="hidden"
               name="CreatedAt"
               value="@edit.CreatedAt" />

        <div class="form-group">
            <label>Book ID</label>

            <input type="number"
                   name="BookId"
                   value="@edit.BookId"
                   class="form-control"
                   required />
        </div>

        <div class="form-group">
            <label>Customer ID</label>

            <input type="number"
                   name="CustomerId"
                   value="@edit.CustomerId"
                   class="form-control"
                   required />
        </div>

        <div class="form-group">
            <label>Rating</label>

            <input type="number"
                   name="Rating"
                   value="@edit.Rating"
                   min="1"
                   max="5"
                   class="form-control"
                   required />
        </div>

        <div class="form-group">
            <label>Comment</label>

            <textarea name="Comment"
                      class="form-control"
                      rows="3">@edit.Comment</textarea>
        </div>

        <br />

        <button type="submit"
                class="btn btn-primary">
            Save Changes
        </button>

        @Html.ActionLink(
            "Cancel",
            "Index",
            "Reviews",
            null,
            new { @class = "btn btn-default" }
        )
    }

    <hr />
}


@if (ViewBag.ReviewDelete != null)
{
    var delete = (PAP.DataAccess.Review)ViewBag.ReviewDelete;

    <div class="panel panel-warning">
        <div class="panel-heading">
            <strong>Confirm Delete</strong>
        </div>

        <div class="panel-body">

            <p>
                Are you sure you want to delete this review?
            </p>

            <p><strong>ID:</strong> @delete.Id</p>
            <p><strong>Book ID:</strong> @delete.BookId</p>
            <p><strong>Customer ID:</strong> @delete.CustomerId</p>
            <p><strong>Rating:</strong> @delete.Rating</p>
            <p><strong>Comment:</strong> @delete.Comment</p>

            @using (Html.BeginForm("Delete", "Reviews", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@delete.Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Confirm Delete
                </button>
            }

            <br />

            @Html.ActionLink(
                "Cancel",
                "Index",
                "Reviews",
                null,
                new { @class = "btn btn-default" }
            )

        </div>
    </div>

    <hr />
}


<h4>Review List</h4>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Book ID</th>
        <th>Customer ID</th>
        <th>Rating</th>
        <th>Comment</th>
        <th>Created At</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.BookId</td>
            <td>@item.CustomerId</td>
            <td>@item.Rating</td>
            <td>@item.Comment</td>
            <td>@item.CreatedAt</td>

            <td>
                @Html.ActionLink(
                    "Edit",
                    "Index",
                    "Reviews",
                    new { editId = item.Id },
                    null
                )
                |
                @Html.ActionLink(
                    "Details",
                    "Index",
                    "Reviews",
                    new { detailsId = item.Id },
                    null
                )
                |
                @Html.ActionLink(
                    "Delete",
                    "Index",
                    "Reviews",
                    new { deleteId = item.Id },
                    null
                )
            </td>
        </tr>
    }
</table>