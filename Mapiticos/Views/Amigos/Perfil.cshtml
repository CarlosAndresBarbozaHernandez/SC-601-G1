@using Mapiticos.Models.ViewModels
@model PerfilPublicoViewModel
@{
    ViewData["Title"] = Model.NombreMostrar;
}

<div class="perfil">

    <header class="perfil-barra">
        <h1 class="perfil-usuario">
            @if (Model.EsPrivada)
            {
                <i class="ti ti-lock" aria-label="Cuenta privada"></i>
            }
            @Model.NombreUsuario
        </h1>
    </header>

    <section class="perfil-cabecera">
        <div class="perfil-avatar" aria-hidden="true">
            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
            {
                <img src="@Model.AvatarUrl" alt="" />
            }
            else
            {
                @Model.Inicial
            }
        </div>
        <ul class="perfil-stats">
            <li><strong>@Model.CantidadAventurasVisibles</strong><span>Aventuras</span></li>
            <li><strong>@Model.CantidadSeguidores</strong><span>Seguidores</span></li>
            <li><strong>@Model.CantidadSiguiendo</strong><span>Siguiendo</span></li>
        </ul>
    </section>

    <section class="perfil-info">
        @if (Model.MeSigue)
        {
            <span class="am-chip">Te sigue</span>
        }
        <h2>@Model.NombreMostrar</h2>
        @if (!string.IsNullOrEmpty(Model.Biografia))
        {
            <p>@Model.Biografia</p>
        }
    </section>

    <form id="formAntiforgery">
        @Html.AntiForgeryToken()
    </form>

    <div class="perfil-botones">
        <button type="button" id="botonSeguir"
                class="@(Model.EstadoSeguimiento == EstadosSeguimiento.Ninguno ? "am-btn" : "am-btn-sec")"
                data-url="@Url.Action("Seguir", "Amigos")"
                data-usuario="@Model.NombreUsuario"
                data-confirmar="@((Model.EsPrivada && Model.EstadoSeguimiento == EstadosSeguimiento.Aceptado) ? "si" : "no")">
            @Model.TextoBotonSeguir
        </button>
    </div>

    @if (!Model.PuedeVer)
    {
        <div class="vacio am-privada">
            <i class="ti ti-lock" aria-hidden="true"></i>
            <h3>Esta cuenta es privada</h3>
            <p>Seguí a esta persona para ver sus aventuras.</p>
        </div>
    }
    else if (!Model.Aventuras.Any())
    {
        <div class="vacio">
            <p>Todavía no hay aventuras para ver.</p>
        </div>
    }
    else
    {
        <div class="perfil-grid">
            @foreach (var a in Model.Aventuras)
            {
                <a asp-controller="Mapa" asp-action="Index" asp-route-aventuraId="@a.AventuraId" class="miniatura">
                    @if (!string.IsNullOrEmpty(a.FotoUrl))
                    {
                        <img src="@a.FotoUrl" alt="" />
                    }
                    <span class="miniatura-etiquetas">
                        @foreach (var e in a.Etiquetas)
                        {
                            <span title="@e.Nombre"><i class="ti @e.Icono" aria-hidden="true"></i></span>
                        }
                    </span>
                    <span class="miniatura-titulo">@a.Titulo</span>
                </a>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/perfil-publico.js" asp-append-version="true"></script>
}
