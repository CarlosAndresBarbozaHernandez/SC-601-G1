            margin: 0;
            font-size: 21px;
            color: #22392B;
            font-family: 'Bricolage Grotesque', sans-serif;
        }

    .bp-cerrar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: none;
        background: #F3F6EC;
        font-size: 18px;
    }

    .bp-tabs {
        display: flex;
        gap: 4px;
        padding: 4px 20px 0;
        border-bottom: 1px solid #eef2ea;
    }

    .bp-tab {
        border: none;
        background: none;
        padding: 10px 12px;
        font-weight: 600;
        color: #4F5D48;
        border-bottom: 2px solid transparent;
    }

        .bp-tab.activa {
            color: #22392B;
            border-bottom-color: #22392B;
        }

    .bp-globito {
        background: #7B3F8C;
        color: #fff;
        border-radius: 999px;
        font-size: 11px;
        padding: 1px 6px;
        margin-left: 4px;
    }

    .bp-input {
        margin: 14px 20px 6px;
        width: calc(100% - 40px);
        padding: 11px 16px;
        border: 1px solid #d5dfce;
        border-radius: 999px;
        background: #F3F6EC;
        color: #22392B;
        outline: none;
        font-family: inherit;
    }

        .bp-input:focus {
            border-color: #4E6B3A;
        }

    .bp-lista {
        overflow-y: auto;
        padding: 6px 12px 14px;
        max-height: 60vh;
    }

    .bp-fila {
