@model string
@using Mapiticos.Servicios
@*
    Logo de Mapiticos según el modo (tema).
    Uso:  <partial name="_Logo" model="temaActual" />
    El mapa, la M y "APITICOS" cambian de color; algunos modos agregan una ilustración.
*@
@{
    var tema = CatalogoTemas.Obtener(Model);
    var uid = Guid.NewGuid().ToString("N")[..8];   // ids únicos si hay varios logos en la misma página
    var arriba = tema.Clave switch { "tucan" => -40, "morpho" => -18, "perezoso" => -18, _ => -4 };
    var alto = 220 - arriba;
    var conIlustracion = tema.Clave is "guaria" or "perezoso" or "tucan" or "carreta" or "morpho";
}
<svg class="logo-svg" viewBox="-4 @arriba 232 @alto" role="img" aria-label="Mapiticos">
    @if (conIlustracion)
    {
        <defs>
            <filter id="hd@(uid)" x="-20%" y="-20%" width="140%" height="140%">
                <feTurbulence type="fractalNoise" baseFrequency="0.09" numOctaves="2" seed="4" result="t" />
                <feDisplacementMap in="SourceGraphic" in2="t" scale="1.5" xChannelSelector="R" yChannelSelector="G" result="d" />
                <feTurbulence type="fractalNoise" baseFrequency="1.4" numOctaves="1" seed="9" result="g" />
                <feColorMatrix in="g" type="matrix" values="0 0 0 0 0.17  0 0 0 0 0.14  0 0 0 0 0.12  0 0 0 0.55 -0.12" result="ga" />
                <feComposite in="ga" in2="d" operator="in" result="gi" />
                <feMerge><feMergeNode in="d" /><feMergeNode in="gi" /></feMerge>
            </filter>
        </defs>
    }
